# ===========================================
# DeFi Multi-Chain Project Environment Config
# ===========================================
# Copy this file to .env and fill in your values

# ========== RPC Endpoints ==========
# Ethereum RPC (Chainstack, Alchemy, Infura, or your own node)
ETH_RPC=https://mainnet.infura.io/v3/YOUR_KEY

# BSC RPC (can use public or private endpoints)
BSC_RPC=https://bsc-dataseed.binance.org/

# Solana RPC (use Helius for best performance - included with API key)
SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ========== Explorer API Keys ==========
# Etherscan (free tier: 5 calls/sec)
# Get from: https://etherscan.io/apis
ETHERSCAN_API_TOKEN=YOUR_ETHERSCAN_KEY

# BSCscan (free tier: 5 calls/sec)
# Get from: https://bscscan.com/apis
BSCSCAN_API_TOKEN=YOUR_BSCSCAN_KEY

# ========== The Graph ==========
# Required for querying the decentralized network
# Get from: https://thegraph.com/studio/
# Note: Subgraph Studio (hosted) is FREE for 100k queries/month
THEGRAPH_API_KEY=YOUR_GRAPH_KEY

# ========== Helius (Solana) ==========
# Free tier: 1,000,000 credits/month
# Get from: https://dev.helius.xyz/
HELIUS_API_KEY=YOUR_HELIUS_KEY

# ========== Market Data ==========
# CoinMarketCap API
# Get from: https://coinmarketcap.com/api/
CMC_API_KEY=YOUR_CMC_KEY

# ========== Database (Optional) ==========
# PostgreSQL connection string (for production caching)
# DATABASE_URL=postgresql://user:password@localhost:5432/defi_db
